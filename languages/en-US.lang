upstreams_page:
  title: "Upstream Proxies"
  sub: "Manage proxy profiles used by upstream routes. This writes to `data/user/upstreams.yaml` and applies to the running proxy right away."
  add: "Add Upstream"
  list: "Upstream List"
  address: "Address"
  address_note: "Only `http://host:port` upstream proxies are supported in this version."
  apply_note: "Upstream proxy changes apply to new requests. Existing outbound connections finish naturally before switching completely."
  none: "No upstream proxies yet."
  summary:
    upstreams: "Upstream Proxies"
  help:
    markdown: |
      ### Upstream Proxies

      Add an upstream proxy address to the list. This version supports `http://host:port`.

      ### Usage

      An upstream proxy only defines an available outbound path. Use Upstream Rules to route specific sites through it.

      ### Apply Timing

      Changes apply to new requests. Existing outbound connections finish naturally before switching completely.

